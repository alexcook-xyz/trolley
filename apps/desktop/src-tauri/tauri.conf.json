{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trolley",
  "version": "0.1.0",
  "identifier": "xyz.alexcook.trolley",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm frontend:dev",
    "beforeBuildCommand": "pnpm frontend:build"
  },
  "app": {
    "windows": [
      {
        "title": "Trolley",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
